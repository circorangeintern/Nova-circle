{
  "info": {
    "_postman_id": "8a5a4a0d-7923-4a6c-a277-publiceye-api",
    "name": "PublicEye MVP API",
    "description": "Core MVP API requests for authentication, citizen reports, public transparency, government workflow, and analytics. Select the PublicEye Local environment before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
