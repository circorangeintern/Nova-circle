    {
      "name": "Citizen Reports",
      "item": [
        {
          "name": "Create report",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('reportId', body.report.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "title",
                  "value": "Postman road issue",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "ROAD",
                  "type": "text"
                },
                {
                  "key": "severity",
                  "value": "HIGH",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "A road issue submitted from the PublicEye Postman collection.",
                  "type": "text"
                },
                {
                  "key": "latitude",
                  "value": "6.5008",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "3.3486",
                  "type": "text"
                },
                {
                  "key": "lga",
                  "value": "Surulere",
                  "type": "text"
                },
                {
                  "key": "state",
                  "value": "Lagos",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            },
            "description": "Select a JPEG, PNG, or WEBP file for the photo field before sending."
          }
        },
        {
          "name": "List my reports",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/mine",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "mine"]
            }
          }
        },
        {
          "name": "Get my report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Update my open report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "description",
                  "value": "Updated in Postman before an official response.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        }
      ]
